    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "   const b = $input.item.json.body;\n   const energie = Number(b.energie_rms);\n   const entropie = Number(b.entropie_spectrale);\n   const freq = Number(b.frequence_dominante_hz);\n   const facteurFreq = (freq > 3 && freq < 30) ? 1.2 : 0.8;\n   const score = Math.min((energie / 100) * (1 / (entropie + 0.01)) * facteurFreq, 10);\n   return { json: { ...$input.item.json, score_vraisemblance: Number(score.toFixed(2)) } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
